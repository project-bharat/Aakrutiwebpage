{
  "$schema": "https://json.schemastore.org/wrangler",
  "name": "aakrutiwebpage",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aakruti-content",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "aakruti-images" }
  ],
  "previews": {}
}
